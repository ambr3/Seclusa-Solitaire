<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRelativeLayoutBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.GameManager">

    <!-- Score/Time live here — below the playfield, never over cards. -->
    <RelativeLayout
        android:id="@+id/bottomChromeBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_bottom_chrome_height"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/linearLayoutMenuBar"
        android:layout_toLeftOf="@+id/linearLayoutMenuBar"
        android:clipChildren="true"
        android:gravity="center_vertical"
        android:paddingEnd="4dp"
        android:paddingRight="4dp">

        <LinearLayout
            android:id="@+id/mainButtonScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="2dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/score_chip_background"
            android:contentDescription="@string/title_activity_statistics"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:onClick="menuClick"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/button_scores"
                android:layout_width="14dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/icon_star" />

            <TextView
                android:id="@+id/mainTextViewScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceMedium" />
        </LinearLayout>

        <TextView
            android:id="@+id/mainTextViewTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/score_chip_background"
            android:elevation="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="200dp"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/mainRelativeLayoutGame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomChromeBar"
        android:layout_toStartOf="@+id/linearLayoutMenuBar"
        android:layout_toLeftOf="@+id/linearLayoutMenuBar"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageView
            android:id="@+id/card_highlight"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:visibility="gone"
            app:srcCompat="@drawable/card_highlight" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/mainRelativeLayoutGameOverlayLower"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomChromeBar"
        android:layout_toStartOf="@+id/linearLayoutMenuBar"
        android:layout_toLeftOf="@+id/linearLayoutMenuBar">

        <TextView
            android:id="@+id/textViewRecycles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circle"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="0"
            android:visibility="gone" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/mainRelativeLayoutGameOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomChromeBar"
        android:layout_toStartOf="@+id/linearLayoutMenuBar"
        android:layout_toLeftOf="@+id/linearLayoutMenuBar">

        <ImageView
            android:id="@+id/mainImageViewResize"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:onClick="menuClick"
            app:srcCompat="@drawable/icon_arrow_right" />

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/shadow_left_to_right" />

        <Button
            android:id="@+id/buttonMainAutoComplete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:background="@drawable/autocomplete_button_background"
            android:elevation="4dp"
            android:onClick="menuClick"
            android:paddingLeft="18dp"
            android:paddingTop="8dp"
            android:paddingRight="18dp"
            android:paddingBottom="8dp"
            android:text="@string/game_auto_complete_text"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/linearLayoutMenuBar"
        android:layout_width="?attr/actionBarSize"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_margin="16dp"
        android:background="@drawable/menu_bar_background"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <FrameLayout
            android:id="@+id/mainButtonRestart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:onClick="menuClick">

            <ImageView
                android:id="@+id/button_restart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/menu_main_menu"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                app:srcCompat="@drawable/icon_menu"
                app:tint="@color/menuBarIcon" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mainButtonHint"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:onClick="menuClick">

            <ImageView
                android:id="@+id/button_hint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/settings_support"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                app:srcCompat="@drawable/icon_lightbulb_on"
                app:tint="@color/menuBarIcon" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mainButtonNewGame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:onClick="menuClick">

            <ImageView
                android:id="@+id/button_new_game"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/menu_new_game"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                app:srcCompat="@drawable/icon_new_game"
                app:tint="@color/menuBarIcon" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mainButtonUndo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:onClick="menuClick">

            <ImageView
                android:id="@+id/button_undo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/menu_undo"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                app:srcCompat="@drawable/icon_undo"
                app:tint="@color/menuBarIcon" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mainButtonSettings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:onClick="menuClick">

            <ImageView
                android:id="@+id/button_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/menu_settings"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                app:srcCompat="@drawable/icon_settings_black"
                app:tint="@color/menuBarIcon" />
        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
