    <!--
        App-wide type scale. Uses the system font (Roboto) like the Decker weather app:
        tight letter-spacing, bold headings and clear hierarchy instead of the default
        Material 3 spacing/weights.
    -->
    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

