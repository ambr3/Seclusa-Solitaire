<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient hero for the game selection screen. Deep palette tone at the top,
     falling to a darker anchor at the bottom, per selected theme colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="?attr/themeGameSelectBackgroundEnd"
        android:startColor="?attr/themeGameSelectBackground" />
</shape>