<?xml version="1.0" encoding="utf-8"?>
<!-- Themed glow tile: primary halo + primaryContainer face (not flat white). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft outer halo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- mid glow (lighter primary tint) -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- face (primary tint — XML fallback; runtime uses blended face) -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSecondaryContainer" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
